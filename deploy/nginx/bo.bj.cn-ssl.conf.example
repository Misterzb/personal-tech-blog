# Standalone Nginx SSL for bo.bj.cn
# In http{} once:
#   limit_req_zone $binary_remote_addr zone=api_limit:10m rate=5r/s;
#   limit_req_zone $binary_remote_addr zone=search_limit:10m rate=1r/s;

server {
    listen 80;
    server_name bo.bj.cn www.bo.bj.cn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name bo.bj.cn www.bo.bj.cn;
    client_max_body_size 10m;

    ssl_certificate     /data/nginx/cert/bo.bj.cn.pem;
    ssl_certificate_key /data/nginx/cert/bo.bj.cn.key;
    ssl_session_timeout 5m;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE:ECDH:AES:HIGH:!NULL:!aNULL:!MD5:!ADH:!RC4;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss image/svg+xml;

    location /api/public/search {
        limit_req zone=search_limit burst=5 nodelay;
        proxy_pass http://127.0.0.1:9476;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://127.0.0.1:9476;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /actuator/health {
        proxy_pass http://127.0.0.1:9476/actuator/health;
        proxy_set_header Host $host;
        access_log off;
    }

    location /uploads/ {
        alias /data/blog/uploads/;
        access_log off;
        expires 7d;
    }

    location = /rss.xml {
        proxy_pass http://127.0.0.1:9476/rss.xml;
    }

    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:9476/sitemap.xml;
    }

    location = /robots.txt {
        proxy_pass http://127.0.0.1:9476/robots.txt;
    }

    # admin/dist 内容放到 /data/blog-admin/admin/
    # 不要用 alias + try_files（会 500）
    location /admin/ {
        alias /data/blog-admin/admin/;
        index index.html;
        if (!-e $request_filename) {
            rewrite ^ /admin/index.html last;
        }
    }

    location = /admin/index.html {
        alias /data/blog-admin/admin/index.html;
    }

    location / {
        root /data/blog-frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
