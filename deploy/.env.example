# 生产示例：外置 MySQL / Redis（复制为 deploy/.env 后改域名与密钥）
# 本地本机库请用 .env.local.example，不要和生产混用。

SPRING_PROFILES_ACTIVE=prod

SITE_BASE_URL=https://bo.bj.cn
SITE_ORIGIN=https://bo.bj.cn
SITE_ORIGIN_WWW=https://www.bo.bj.cn

SPRING_DATASOURCE_URL=jdbc:mysql://39.107.247.76:3306/blog?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=blog
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

REDIS_HOST=39.107.247.76
REDIS_PORT=6379
REDIS_DB=10
REDIS_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
BLOG_RESPONSE_AES_KEY=CHANGE_ME_EXACTLY_32_CHAR_AES_KEY!!

UPLOAD_DIR=/app/uploads
