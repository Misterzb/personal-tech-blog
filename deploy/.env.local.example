# 仅拉起本机 MySQL + Redis（开发用），与生产 deploy/.env 密码/库号分离
# 用法:
#   cp deploy/.env.local.example deploy/.env.local
#   cd deploy && docker compose --env-file .env.local up -d mysql redis
#
# 对应后端: application-local.yml → 127.0.0.1:3307 + Redis db 10

SPRING_DATASOURCE_PASSWORD=local_mysql_dev_only
REDIS_PASSWORD=local_redis_dev_only
REDIS_DB=10
